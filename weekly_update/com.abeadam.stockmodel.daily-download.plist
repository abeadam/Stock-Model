<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.abeadam.stockmodel.daily-download</string>

    <!-- Steps 0-1 only: pull the session that just closed. Retraining stays weekly. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/abeadam/dev/model/Stock-Model/weekly_update/run_weekly_update.sh</string>
        <string>--download-only</string>
    </array>

    <!-- Monday to Friday at 14:35 local (Pacific) time: ES and VXM close at
         17:00 ET = 14:00 PT, and download_daily.py saves a day only once its
         close is 30 minutes old. Weekday 1 = Monday. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>35</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>35</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>35</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>35</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>35</integer>
        </dict>
    </array>

    <!-- Never run just because the job was loaded. -->
    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/abeadam/dev/model/Stock-Model/weekly_update</string>

    <key>StandardOutPath</key>
    <string>/Users/abeadam/dev/model/Stock-Model/weekly_update/logs/launchd.daily-download.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/abeadam/dev/model/Stock-Model/weekly_update/logs/launchd.daily-download.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/abeadam</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
